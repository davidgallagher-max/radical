{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'no packages to install'",
  "buildCommand": "bash scripts/build_site.sh",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/data/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "/(index\\.html)?",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "/(radical/)?privacy/?",
      "dest": "/upslope/radical-privacy.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "upslopelabs.com"
        }
      ],
      "dest": "/upslope/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.upslopelabs.com"
        }
      ],
      "dest": "/upslope/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  }
}
